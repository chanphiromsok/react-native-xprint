{
  "expo": {
    "name": "Xprinter Example",
    "slug": "react-native-xprint-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xprinter.example",
      "appleTeamId": "4QDQZA9V92",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Xprinter Example uses Bluetooth to find and connect to nearby label and receipt printers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "xprinter.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
